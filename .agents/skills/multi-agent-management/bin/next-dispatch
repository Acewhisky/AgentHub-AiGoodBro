#!/bin/sh
# Reuse the user's installed tools; never download or run an installer here.
set -eu
skill_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python_path=${CAMNEXT_PYTHON:-}
if [ -z "$python_path" ] && [ -f "$skill_root/config/runtime-python.txt" ] && [ ! -L "$skill_root/config/runtime-python.txt" ]; then
  IFS= read -r python_path < "$skill_root/config/runtime-python.txt" || true
fi
if [ -z "$python_path" ]; then
  for candidate in python3 python3.14 python3.13 python3.12 python3.11 python3.10 python3.9; do
    candidate_path=$(command -v "$candidate" 2>/dev/null || true)
    if [ -n "$candidate_path" ] && "$candidate_path" -I -B -c 'import sys; sys.exit(0 if (3,9) <= sys.version_info < (4,) else 1)' >/dev/null 2>&1; then
      python_path=$candidate_path
      break
    fi
  done
fi
if [ -z "$python_path" ] || [ ! -x "$python_path" ] || ! "$python_path" -I -B -c 'import sys; sys.exit(0 if (3,9) <= sys.version_info < (4,) else 1)' >/dev/null 2>&1; then
  echo 'NEXT_PYTHON_MISSING: Open Next > Getting started > Prepare your tools. Install or select Python 3.9+, then check again.' >&2
  exit 1
fi
if [ "${1:-}" = preflight ]; then
  shift
  exec "$python_path" -E -s -B "$skill_root/scripts/next_dispatch_preflight.py" "$@"
fi
exec "$python_path" -E -s -B "$skill_root/scripts/next_dispatch_activity.py" "$@"
